---
import '../styles/global.css'

import '@fontsource/inter/300.css'
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/playfair-display/400.css'
import '@fontsource/playfair-display/400-italic.css'
import '@fontsource/playfair-display/500.css'
import '@fontsource/playfair-display/500-italic.css'
import '@fontsource/playfair-display/600.css'
import '@fontsource/playfair-display/700.css'

import { Image } from 'astro:assets'
import logoBlack from '../assets/logo-black.png'
import salon from '../data/salon.json'

interface Props {
	title: string;
	description?: string;
}

const { title, description = `${salon.vollname} - ${salon.beschreibung}` } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ? new URL(base, Astro.site).href : '';
const ogImage = `${siteUrl}/og-image.jpg`;

const navLinks = [
	{ href: `${base}/`, label: 'Home' },
	{ href: `${base}/leistungen`, label: 'Leistungen' },
	{ href: `${base}/ueber-uns`, label: 'Über uns' },
	{ href: `${base}/kontakt`, label: 'Kontakt' },
];
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={new URL(currentPath, Astro.site).href} />
		<meta property="og:locale" content="de_DE" />
		<meta property="og:site_name" content={salon.vollname} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body class="min-h-screen bg-white antialiased">
		<!-- ========== Navigation ========== -->
		<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent">
			<nav class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="flex items-center justify-between h-20">
					<!-- Logo -->
					<a href={`${base}/`}>
						<Image src={logoBlack} alt={salon.vollname} height={96} quality={90} class="h-12 w-auto" />
					</a>

					<!-- Desktop Navigation -->
					<div class="hidden md:flex items-center gap-8">
						<!-- Home -->
						<a
							href={`${base}/`}
							class:list={[
								'text-[0.8125rem] font-medium tracking-[0.08em] uppercase transition-colors duration-300 hover:text-gold',
								currentPath === `${base}/` ? 'text-gold' : 'text-text-secondary'
							]}
						>
							Home
						</a>

						<!-- Leistungen mit Dropdown -->
						<div class="relative group">
							<a
								href={`${base}/leistungen`}
								class:list={[
									'text-[0.8125rem] font-medium tracking-[0.08em] uppercase transition-colors duration-300 hover:text-gold inline-flex items-center gap-1',
									currentPath.startsWith(`${base}/leistungen`) ? 'text-gold' : 'text-text-secondary'
								]}
							>
								Leistungen
								<svg class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path d="M19 9l-7 7-7-7" />
								</svg>
							</a>
							<div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-300">
								<div class="bg-white rounded-lg shadow-lg border border-beige/60 py-2 min-w-[220px]">
									<a
										href={`${base}/leistungen`}
										class:list={[
											'block px-5 py-2.5 text-xs font-medium tracking-[0.06em] uppercase transition-colors duration-200 hover:bg-cream hover:text-gold',
											currentPath === `${base}/leistungen` ? 'text-gold' : 'text-text-secondary'
										]}
									>
										Alle Leistungen
									</a>
									<div class="mx-4 my-1 border-t border-beige/40"></div>
									{salon.leistungen.map((l) => (
										<a
											href={`${base}/leistungen/${l.id}`}
											class:list={[
												'block px-5 py-2.5 text-xs font-medium tracking-[0.04em] transition-colors duration-200 hover:bg-cream hover:text-gold',
												currentPath === `${base}/leistungen/${l.id}` ? 'text-gold' : 'text-text-secondary'
											]}
										>
											{l.titel}
										</a>
									))}
								</div>
							</div>
						</div>

						<!-- Über uns -->
						<a
							href={`${base}/ueber-uns`}
							class:list={[
								'text-[0.8125rem] font-medium tracking-[0.08em] uppercase transition-colors duration-300 hover:text-gold',
								currentPath === `${base}/ueber-uns` ? 'text-gold' : 'text-text-secondary'
							]}
						>
							Über uns
						</a>

						<!-- Kontakt -->
						<a
							href={`${base}/kontakt`}
							class:list={[
								'text-[0.8125rem] font-medium tracking-[0.08em] uppercase transition-colors duration-300 hover:text-gold',
								currentPath === `${base}/kontakt` ? 'text-gold' : 'text-text-secondary'
							]}
						>
							Kontakt
						</a>
					</div>

					<!-- Mobile Menu Button -->
					<button
						id="mobile-menu-btn"
						class="md:hidden flex flex-col gap-1.5 p-2"
						aria-label="Menü öffnen"
					>
						<span class="block w-6 h-px bg-text-primary transition-all duration-300" id="bar1"></span>
						<span class="block w-6 h-px bg-text-primary transition-all duration-300" id="bar2"></span>
						<span class="block w-4 h-px bg-text-primary transition-all duration-300 ml-auto" id="bar3"></span>
					</button>
				</div>
			</nav>

			<!-- Mobile Menu -->
			<div id="mobile-menu" class="hidden md:hidden bg-white/98 backdrop-blur-md border-t border-beige">
				<div class="px-6 py-8 flex flex-col gap-6">
					<!-- Home -->
					<a
						href={`${base}/`}
						class:list={[
							'text-sm font-medium tracking-[0.08em] uppercase transition-colors duration-300',
							currentPath === `${base}/` ? 'text-gold' : 'text-text-secondary'
						]}
					>
						Home
					</a>

					<!-- Leistungen mit Sub-Menü -->
					<div>
						<button
							id="mobile-leistungen-btn"
							class:list={[
								'text-sm font-medium tracking-[0.08em] uppercase transition-colors duration-300 inline-flex items-center gap-1.5 w-full',
								currentPath.startsWith(`${base}/leistungen`) ? 'text-gold' : 'text-text-secondary'
							]}
						>
							Leistungen
							<svg id="mobile-leistungen-chevron" class="w-3 h-3 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path d="M19 9l-7 7-7-7" />
							</svg>
						</button>
						<div id="mobile-leistungen-sub" class="hidden mt-3 ml-4 flex flex-col gap-3 border-l border-beige/60 pl-4">
							<a
								href={`${base}/leistungen`}
								class:list={[
									'text-xs font-medium tracking-[0.06em] uppercase transition-colors duration-200 hover:text-gold',
									currentPath === `${base}/leistungen` ? 'text-gold' : 'text-text-secondary'
								]}
							>
								Alle Leistungen
							</a>
							{salon.leistungen.map((l) => (
								<a
									href={`${base}/leistungen/${l.id}`}
									class:list={[
										'text-xs font-medium tracking-[0.04em] transition-colors duration-200 hover:text-gold',
										currentPath === `${base}/leistungen/${l.id}` ? 'text-gold' : 'text-text-secondary'
									]}
								>
									{l.titel}
								</a>
							))}
						</div>
					</div>

					<!-- Über uns -->
					<a
						href={`${base}/ueber-uns`}
						class:list={[
							'text-sm font-medium tracking-[0.08em] uppercase transition-colors duration-300',
							currentPath === `${base}/ueber-uns` ? 'text-gold' : 'text-text-secondary'
						]}
					>
						Über uns
					</a>

					<!-- Kontakt -->
					<a
						href={`${base}/kontakt`}
						class:list={[
							'text-sm font-medium tracking-[0.08em] uppercase transition-colors duration-300',
							currentPath === `${base}/kontakt` ? 'text-gold' : 'text-text-secondary'
						]}
					>
						Kontakt
					</a>
				</div>
			</div>
		</header>

		<!-- ========== Hauptinhalt ========== -->
		<main>
			<slot />
		</main>

		<!-- ========== Footer ========== -->
		<footer class="bg-text-primary text-beige">
			<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 lg:py-20">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
					<!-- Spalte 1: Marke -->
					<div>
						<a href={`${base}/`} class="inline-block mb-6">
							<span class="font-serif text-2xl font-semibold text-white">{salon.name}</span>
							<span class="block text-[0.65rem] font-medium tracking-[0.25em] uppercase text-gold-light mt-0.5">by {salon.inhaber}</span>
						</a>
						<p class="text-sand text-sm leading-relaxed max-w-xs">
							{salon.beschreibung}
						</p>
					</div>

					<!-- Spalte 2: Öffnungszeiten -->
					<div>
						<h3 class="text-white text-sm font-sans font-medium tracking-[0.15em] uppercase mb-6">Öffnungszeiten</h3>
						<div class="space-y-2 text-sm text-sand">
							{salon.oeffnungszeiten.filter(o => o.tag !== 'Sonntag').map((o) => (
								<div class="flex justify-between">
									<span>{o.tag}</span>
									<span class={!o.zeit ? 'text-sand-dark' : ''}>{o.zeit ?? 'Geschlossen'}</span>
								</div>
							))}
						</div>
					</div>

					<!-- Spalte 3: Kontakt -->
					<div>
						<h3 class="text-white text-sm font-sans font-medium tracking-[0.15em] uppercase mb-6">Kontakt</h3>
						<div class="space-y-3 text-sm text-sand">
							<p>{salon.adresse.strasse}<br />{salon.adresse.plz} {salon.adresse.ort}</p>
							<p>
								<a href={salon.kontakt.telefonLink} class="hover:text-gold-light transition-colors">{salon.kontakt.telefon}</a>
							</p>
							<p>
								<a href={salon.kontakt.whatsappLink} target="_blank" rel="noopener noreferrer" class="hover:text-gold-light transition-colors">WhatsApp</a>
							</p>
							<p>
								<a href={salon.kontakt.instagramLink} target="_blank" rel="noopener noreferrer" class="hover:text-gold-light transition-colors">@{salon.kontakt.instagram}</a>
							</p>
						</div>
					</div>
				</div>

				<!-- Copyright & Rechtliches -->
				<div class="mt-16 pt-8 border-t border-white/10 text-center">
					<p class="text-xs text-sand-dark tracking-wide">
						&copy; {new Date().getFullYear()} {salon.vollname}. Alle Rechte vorbehalten.
					</p>
					<div class="mt-3 flex justify-center gap-4 text-xs text-sand-dark">
						<a href={`${base}/impressum`} class="hover:text-gold-light transition-colors">Impressum</a>
						<span class="text-white/20">|</span>
						<a href={`${base}/datenschutz`} class="hover:text-gold-light transition-colors">Datenschutz</a>
						<span class="text-white/20">|</span>
						<a href={`${base}/cookies`} class="hover:text-gold-light transition-colors">Cookies</a>
					</div>
				</div>
			</div>
		</footer>

		<!-- ========== Scripts ========== -->
		<script>
			// Mobile Menü Toggle
			const menuBtn = document.getElementById('mobile-menu-btn');
			const mobileMenu = document.getElementById('mobile-menu');
			const bar1 = document.getElementById('bar1');
			const bar2 = document.getElementById('bar2');
			const bar3 = document.getElementById('bar3');
			let isMenuOpen = false;

			menuBtn?.addEventListener('click', () => {
				isMenuOpen = !isMenuOpen;
				mobileMenu?.classList.toggle('hidden');

				if (isMenuOpen) {
					bar1!.style.transform = 'rotate(45deg) translate(4px, 4px)';
					bar2!.style.opacity = '0';
					bar3!.style.transform = 'rotate(-45deg) translate(3px, -3px)';
					bar3!.style.width = '1.5rem';
				} else {
					bar1!.style.transform = '';
					bar2!.style.opacity = '1';
					bar3!.style.transform = '';
					bar3!.style.width = '1rem';
				}
			});

			// Mobile Leistungen Sub-Menü Toggle
			const leistungenBtn = document.getElementById('mobile-leistungen-btn');
			const leistungenSub = document.getElementById('mobile-leistungen-sub');
			const leistungenChevron = document.getElementById('mobile-leistungen-chevron');
			let isLeistungenOpen = false;

			leistungenBtn?.addEventListener('click', () => {
				isLeistungenOpen = !isLeistungenOpen;
				leistungenSub?.classList.toggle('hidden');
				if (isLeistungenOpen) {
					leistungenChevron!.style.transform = 'rotate(180deg)';
				} else {
					leistungenChevron!.style.transform = '';
				}
			});

			// Header-Hintergrund beim Scrollen
			const header = document.getElementById('site-header');
			window.addEventListener('scroll', () => {
				if (window.scrollY > 50) {
					header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
					header?.classList.remove('bg-transparent');
				} else {
					header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
					header?.classList.add('bg-transparent');
				}
			});
		</script>
	</body>
</html>
