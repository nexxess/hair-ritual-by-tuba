---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { Icon } from "astro-icon/components";
import salon from "../data/salon.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title={`Kontakt – ${salon.vollname}`}
  description={`Vereinbaren Sie Ihren Termin bei ${salon.vollname}. Wir freuen uns auf Ihren Besuch.`}
>

  <!-- ========== 1. PageHeader ========== -->
  <PageHeader label="Kontakt" description="Vereinbaren Sie Ihren persönlichen Termin oder besuchen Sie uns direkt im Salon. Wir antworten in der Regel innerhalb weniger Stunden.">
    Wir freuen uns<br />
    <span class="italic">auf Sie</span>
  </PageHeader>

  <!-- ========== 2. Kontakt-CTAs ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="section-label">Termin vereinbaren</span>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
          So erreichen Sie uns
        </h2>
        <div class="divider"></div>
        <p class="mt-4 text-text-secondary leading-relaxed max-w-2xl mx-auto">
          Wählen Sie Ihren bevorzugten Kontaktweg – wir freuen uns auf Ihre Nachricht und melden uns schnellstmöglich.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <!-- Telefon -->
        <a href={salon.kontakt.telefonLink} class="group flex flex-col items-center text-center p-8 bg-cream hover:bg-beige transition-colors">
          <div class="w-14 h-14 flex items-center justify-center bg-white border border-beige-dark/30 mb-5 group-hover:border-gold transition-colors">
            <Icon name="lucide:phone" class="w-6 h-6 text-gold" />
          </div>
          <h3 class="font-serif text-lg font-semibold text-text-primary mb-1">Anrufen</h3>
          <p class="text-sm text-text-secondary mb-4">Direkt einen Termin vereinbaren</p>
          <span class="text-gold font-medium group-hover:underline">{salon.kontakt.telefon}</span>
        </a>

        <!-- WhatsApp -->
        <a href={salon.kontakt.whatsappLink} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center text-center p-8 bg-cream hover:bg-beige transition-colors">
          <div class="w-14 h-14 flex items-center justify-center bg-white border border-beige-dark/30 mb-5 group-hover:border-[#25D366] transition-colors">
            <Icon name="simple-icons:whatsapp" class="w-6 h-6 text-[#25D366]" />
          </div>
          <h3 class="font-serif text-lg font-semibold text-text-primary mb-1">WhatsApp</h3>
          <p class="text-sm text-text-secondary mb-4">Schreiben Sie uns bequem per Chat</p>
          <span class="text-[#25D366] font-medium group-hover:underline">Nachricht senden</span>
        </a>

        <!-- Instagram -->
        <a href={salon.kontakt.instagramLink} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center text-center p-8 bg-cream hover:bg-beige transition-colors">
          <div class="w-14 h-14 flex items-center justify-center bg-white border border-beige-dark/30 mb-5 group-hover:border-[#E1306C] transition-colors">
            <Icon name="simple-icons:instagram" class="w-6 h-6 text-[#E1306C]" />
          </div>
          <h3 class="font-serif text-lg font-semibold text-text-primary mb-1">Instagram</h3>
          <p class="text-sm text-text-secondary mb-4">Folgen Sie uns & schreiben Sie eine DM</p>
          <span class="text-[#E1306C] font-medium group-hover:underline">@{salon.kontakt.instagram}</span>
        </a>
      </div>

      <!-- Tipp -->
      <div class="mt-10 p-6 bg-cream border-l-2 border-gold">
        <p class="text-sm text-text-secondary leading-relaxed">
          <strong class="text-text-primary">Tipp:</strong> Für kurzfristige Termine
          erreichen Sie uns am besten telefonisch. Wir bemühen uns, auch spontane
          Wünsche möglich zu machen.
        </p>
      </div>
    </div>
  </section>

  <!-- ========== 3. Infos & Öffnungszeiten ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-beige">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 lg:gap-16">
        <!-- Adresse -->
        <div>
          <h3 class="text-xs font-medium tracking-[0.15em] uppercase text-gold mb-4">Salon</h3>
          <p class="text-text-primary leading-relaxed">
            {salon.vollname}<br />
            {salon.adresse.strasse}<br />
            {salon.adresse.plz} {salon.adresse.ort}
          </p>
        </div>

        <!-- Öffnungszeiten -->
        <div>
          <h3 class="text-xs font-medium tracking-[0.15em] uppercase text-gold mb-4">Öffnungszeiten</h3>
          <div class="space-y-2 text-text-primary">
            {salon.oeffnungszeiten.map((o) => (
              <div class="flex justify-between max-w-xs">
                <span>{o.tag}</span>
                <span class={!o.zeit ? 'text-text-muted' : ''}>{o.zeit ?? 'Geschlossen'}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Hinweis Sondertermine -->
      <div class="mt-10 p-6 bg-cream border-l-2 border-gold">
        <p class="text-sm text-text-secondary leading-relaxed">
          Für Bräute sowie für besondere Anlässe biete ich nach Absprache auch Termine außerhalb der regulären Öffnungszeiten an. Ein früherer Beginn ist jederzeit möglich.
        </p>
      </div>
    </div>
  </section>

  <!-- ========== 4. Google Maps ========== -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 lg:py-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="section-label">So finden Sie uns</span>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
          Unser Standort
        </h2>
        <div class="divider"></div>
        <p class="mt-4 text-text-secondary leading-relaxed">
          {salon.adresse.strasse}, {salon.adresse.plz} {salon.adresse.ort} – zentral gelegen mit guter Parkmöglichkeit.
        </p>
      </div>
      <div class="w-full h-80 lg:h-96 bg-cream">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2471.5!2d8.841!3d51.808!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47ba4a1f1a3b3b3b%3A0x0!2sOrtsmitte+5%2C+33189+Schlangen!5e0!3m2!1sde!2sde!4v1"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Standort Hair Ritual by Tuba"
          class="w-full h-full"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ========== 5. FAQ ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-beige">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="section-label">Häufige Fragen</span>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
          Gut zu wissen
        </h2>
        <div class="divider"></div>
      </div>
      <div class="space-y-6">
        {salon.faq.map((item) => (
          <details class="group bg-white p-6 cursor-pointer">
            <summary class="flex items-center justify-between font-serif text-lg font-semibold text-text-primary list-none">
              {item.frage}
              <Icon name="lucide:chevron-down" class="w-5 h-5 text-gold shrink-0 ml-4 transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-4 text-text-secondary leading-relaxed text-sm">
              {item.antwort}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
