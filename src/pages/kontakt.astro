---
import Layout from "../layouts/Layout.astro";
import salon from "../data/salon.json";
---

<Layout
  title={`Kontakt – ${salon.vollname}`}
  description={`Vereinbaren Sie Ihren Termin bei ${salon.vollname}. Wir freuen uns auf Ihren Besuch.`}
>

  <!-- ========== Page Header ========== -->
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-20 bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <span class="section-label">Kontakt</span>
      <h1 class="mt-4 font-serif text-4xl sm:text-5xl font-semibold text-text-primary">
        Wir freuen uns<br />
        <span class="italic">auf Sie</span>
      </h1>
      <div class="divider divider-left"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-lg">
        Vereinbaren Sie Ihren persönlichen Termin oder besuchen Sie uns direkt
        im Salon. Wir beraten Sie gerne.
      </p>
    </div>
  </section>

  <!-- ========== Kontakt Inhalt ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">

        <!-- Kontaktformular -->
        <div>
          <h2 class="font-serif text-2xl font-semibold text-text-primary mb-2">
            Nachricht senden
          </h2>
          <p class="text-text-secondary text-sm mb-8">
            Füllen Sie das Formular aus und wir melden uns schnellstmöglich bei Ihnen.
          </p>

          <form class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="vorname" class="block text-xs font-medium tracking-[0.1em] uppercase text-text-secondary mb-2">Vorname</label>
                <input type="text" id="vorname" name="vorname" required class="w-full px-4 py-3 bg-cream border border-beige-dark/50 text-text-primary text-sm focus:outline-none focus:border-gold transition-colors" placeholder="Ihr Vorname" />
              </div>
              <div>
                <label for="nachname" class="block text-xs font-medium tracking-[0.1em] uppercase text-text-secondary mb-2">Nachname</label>
                <input type="text" id="nachname" name="nachname" required class="w-full px-4 py-3 bg-cream border border-beige-dark/50 text-text-primary text-sm focus:outline-none focus:border-gold transition-colors" placeholder="Ihr Nachname" />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-medium tracking-[0.1em] uppercase text-text-secondary mb-2">E-Mail</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-cream border border-beige-dark/50 text-text-primary text-sm focus:outline-none focus:border-gold transition-colors" placeholder="ihre@email.de" />
            </div>

            <div>
              <label for="telefon" class="block text-xs font-medium tracking-[0.1em] uppercase text-text-secondary mb-2">
                Telefon <span class="normal-case tracking-normal text-text-muted">(optional)</span>
              </label>
              <input type="tel" id="telefon" name="telefon" class="w-full px-4 py-3 bg-cream border border-beige-dark/50 text-text-primary text-sm focus:outline-none focus:border-gold transition-colors" placeholder={salon.kontakt.telefon} />
            </div>

            <div>
              <label for="leistung" class="block text-xs font-medium tracking-[0.1em] uppercase text-text-secondary mb-2">Gewünschte Leistung</label>
              <select id="leistung" name="leistung" class="w-full px-4 py-3 bg-cream border border-beige-dark/50 text-text-primary text-sm focus:outline-none focus:border-gold transition-colors appearance-none">
                <option value="">Bitte wählen</option>
                {salon.leistungen.map((l) => (
                  <option value={l.id}>{l.titel}</option>
                ))}
              </select>
            </div>

            <div>
              <label for="nachricht" class="block text-xs font-medium tracking-[0.1em] uppercase text-text-secondary mb-2">Nachricht</label>
              <textarea id="nachricht" name="nachricht" rows="5" class="w-full px-4 py-3 bg-cream border border-beige-dark/50 text-text-primary text-sm focus:outline-none focus:border-gold transition-colors resize-none" placeholder="Ihre Nachricht an uns..."></textarea>
            </div>

            <button type="submit" class="btn-primary w-full sm:w-auto text-center">
              Nachricht senden
            </button>
          </form>
        </div>

        <!-- Kontaktinformationen -->
        <div class="space-y-12">
          <!-- Adresse -->
          <div>
            <h3 class="text-xs font-medium tracking-[0.15em] uppercase text-gold mb-4">Salon</h3>
            <p class="text-text-primary leading-relaxed">
              {salon.vollname}<br />
              {salon.adresse.strasse}<br />
              {salon.adresse.plz} {salon.adresse.ort}
            </p>
          </div>

          <!-- Kontaktdaten -->
          <div>
            <h3 class="text-xs font-medium tracking-[0.15em] uppercase text-gold mb-4">Kontaktdaten</h3>
            <div class="space-y-3">
              <p class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                <a href={salon.kontakt.telefonLink} class="text-text-primary hover:text-gold transition-colors">{salon.kontakt.telefon}</a>
              </p>
              <p class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 00.917.918l4.462-1.494A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.94 9.94 0 01-5.39-1.587l-.376-.232-2.647.886.886-2.646-.232-.376A9.94 9.94 0 012.654 12.5 9.949 9.949 0 0112 2a9.95 9.95 0 0112 9.5A9.949 9.949 0 0112 22z"/></svg>
                <a href={salon.kontakt.whatsappLink} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-gold transition-colors">WhatsApp</a>
              </p>
              <p class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gold shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                <a href={salon.kontakt.instagramLink} target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-gold transition-colors">@{salon.kontakt.instagram}</a>
              </p>
            </div>
          </div>

          <!-- Öffnungszeiten -->
          <div>
            <h3 class="text-xs font-medium tracking-[0.15em] uppercase text-gold mb-4">Öffnungszeiten</h3>
            <div class="space-y-2 text-text-primary">
              {salon.oeffnungszeiten.map((o) => (
                <div class="flex justify-between max-w-xs">
                  <span>{o.tag}</span>
                  <span class={!o.zeit ? 'text-text-muted' : ''}>{o.zeit ?? 'Geschlossen'}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Hinweis -->
          <div class="p-6 bg-cream border-l-2 border-gold">
            <p class="text-sm text-text-secondary leading-relaxed">
              <strong class="text-text-primary">Tipp:</strong> Für kurzfristige Termine
              erreichen Sie uns am besten telefonisch. Wir bemühen uns, auch spontane
              Wünsche möglich zu machen.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
