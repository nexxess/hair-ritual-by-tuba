---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Hair Ritual by Tuba – Friseursalon für moderne Schnitttechniken">
  <!-- ========== Hero Section ========== -->
  <section class="relative min-h-screen flex items-center bg-cream">
    <!-- Dekorativer Hintergrund -->
    <div class="absolute inset-0 overflow-hidden">
      <div
        class="absolute top-0 right-0 w-1/2 h-full bg-beige/50 hidden lg:block"
      >
      </div>
      <div class="absolute bottom-0 left-1/4 w-px h-1/3 bg-gold/20"></div>
      <div class="absolute top-1/4 right-1/3 w-px h-1/4 bg-gold/10"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 py-32 lg:py-0 w-full">
      <div class="max-w-2xl">
        <span class="section-label animate-fade-in-up"
          >Willkommen bei Hair Ritual</span
        >
        <h1
          class="mt-6 font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.1] text-text-primary animate-fade-in-up animate-delay-1"
        >
          Ihr Haar verdient<br />
          <span class="italic text-gold">besondere</span> Pflege
        </h1>
        <p
          class="mt-6 text-lg text-text-secondary leading-relaxed max-w-lg animate-fade-in-up animate-delay-2"
        >
          Moderne Schnitttechniken, hochwertige Pflegeprodukte und individuelle
          Beratung – für ein Ergebnis, das Sie begeistert.
        </p>
        <div
          class="mt-10 flex flex-wrap gap-4 animate-fade-in-up animate-delay-3"
        >
          <a href="/kontakt" class="btn-primary">Termin vereinbaren</a>
          <a href="#leistungen" class="btn-outline">Unsere Leistungen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Leistungen ========== -->
  <section
    id="leistungen"
    class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white"
  >
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-2xl mx-auto">
        <span class="section-label">Was wir bieten</span>
        <h2
          class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
        >
          Unsere Leistungen
        </h2>
        <div class="divider"></div>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Von klassischen Schnitten bis zu modernen Farbtechniken – wir bieten
          Ihnen ein umfassendes Angebot für Ihr individuelles Styling.
        </p>
      </div>

      <!-- Leistungen Grid -->
      <div
        class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10"
      >
        <!-- Karte 1 -->
        <div
          class="group p-8 lg:p-10 bg-cream hover:bg-beige transition-colors duration-500"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border border-gold/30 text-gold mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M12 2a10 10 0 100 20 10 10 0 000-20z"
              ></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">
            Schnitt & Styling
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Präzise Schnitte mit modernen Techniken – vom klassischen Look bis
            zum trendigen Statement. Individuell auf Ihre Haarstruktur und Ihren
            Typ abgestimmt.
          </p>
        </div>

        <!-- Karte 2 -->
        <div
          class="group p-8 lg:p-10 bg-cream hover:bg-beige transition-colors duration-500"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border border-gold/30 text-gold mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
              ></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">
            Coloration & Balayage
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Natürliche Farbverläufe und leuchtende Farbergebnisse mit schonenden
            Premium-Produkten. Balayage, Highlights und kreative Farbtechniken.
          </p>
        </div>

        <!-- Karte 3 -->
        <div
          class="group p-8 lg:p-10 bg-cream hover:bg-beige transition-colors duration-500"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border border-gold/30 text-gold mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
              ></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">
            Pflege & Treatments
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Intensive Haarpflege mit hochwertigen Produkten.
            Keratin-Behandlungen, Repair-Kuren und individuelle Pflegeprogramme
            für gesundes, glänzendes Haar.
          </p>
        </div>

        <!-- Karte 4 -->
        <div
          class="group p-8 lg:p-10 bg-cream hover:bg-beige transition-colors duration-500"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border border-gold/30 text-gold mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">
            Braut & Event
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Perfekte Frisuren für Ihren besonderen Tag. Hochsteckfrisuren,
            Brautstyling und Event-Looks – mit Probetermin und persönlicher
            Beratung.
          </p>
        </div>

        <!-- Karte 5 -->
        <div
          class="group p-8 lg:p-10 bg-cream hover:bg-beige transition-colors duration-500"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border border-gold/30 text-gold mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">
            Herren
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Klassische und moderne Herrenschnitte mit Präzision. Fade-Cuts,
            Bartpflege und Styling – für den gepflegten Auftritt.
          </p>
        </div>

        <!-- Karte 6 -->
        <div
          class="group p-8 lg:p-10 bg-cream hover:bg-beige transition-colors duration-500"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border border-gold/30 text-gold mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
              ></path>
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">
            Produkte & Beratung
          </h3>
          <p class="text-text-secondary text-sm leading-relaxed">
            Ausgewählte Premium-Pflegeprodukte für zu Hause. Persönliche
            Beratung zur optimalen Haarpflege-Routine – abgestimmt auf Ihre
            Bedürfnisse.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Über uns Teaser ========== -->
  <section
    id="ueber-uns"
    class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-beige"
  >
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center"
      >
        <!-- Text -->
        <div>
          <span class="section-label">Über uns</span>
          <h2
            class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
          >
            Leidenschaft für<br />
            <span class="italic">perfektes Haar</span>
          </h2>
          <div class="divider divider-left"></div>
          <p class="mt-6 text-text-secondary leading-relaxed">
            Bei Hair Ritual by Tuba verbinden wir jahrelange Erfahrung mit den
            neuesten Trends und Techniken. Jeder Besuch beginnt mit einer
            persönlichen Beratung, denn wir glauben: Großartiges Haar entsteht
            durch Zuhören, Verstehen und handwerkliches Können.
          </p>
          <p class="mt-4 text-text-secondary leading-relaxed">
            Wir arbeiten ausschließlich mit hochwertigen Pflegeprodukten und
            legen besonderen Wert auf schonende Behandlungen, die Ihr Haar
            langfristig gesund und strahlend halten.
          </p>
          <div class="mt-10">
            <a href="/kontakt" class="btn-primary">Lernen Sie uns kennen</a>
          </div>
        </div>

        <!-- Dekoratives Element (Platzhalter für Bild) -->
        <div class="relative">
          <div
            class="aspect-[4/5] bg-cream-dark flex items-center justify-center"
          >
            <div class="text-center p-8">
              <div
                class="w-20 h-20 mx-auto mb-6 border border-gold/30 flex items-center justify-center"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-8 h-8 text-gold/50"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <p class="text-text-muted text-sm">Hier kommt Ihr Bild hin</p>
            </div>
          </div>
          <!-- Dekorativer Rahmen -->
          <div
            class="absolute -bottom-4 -right-4 w-full h-full border border-gold/20 -z-10"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Vertrauens-Elemente ========== -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 text-center">
        <div>
          <p class="font-serif text-4xl font-semibold text-gold">10+</p>
          <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">
            Jahre Erfahrung
          </p>
        </div>
        <div>
          <p class="font-serif text-4xl font-semibold text-gold">Premium</p>
          <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">
            Pflegeprodukte
          </p>
        </div>
        <div>
          <p class="font-serif text-4xl font-semibold text-gold">100%</p>
          <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">
            Individuelle Beratung
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CTA Section ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <span class="section-label">Bereit für Ihr neues Ich?</span>
      <h2
        class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
      >
        Vereinbaren Sie Ihren Termin
      </h2>
      <div class="divider"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-xl mx-auto">
        Wir freuen uns darauf, Sie in unserem Salon willkommen zu heißen.
        Kontaktieren Sie uns für eine persönliche Beratung oder einen Termin.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/kontakt" class="btn-primary">Jetzt Termin buchen</a>
        <a href="tel:+4912345678" class="btn-outline">Anrufen</a>
      </div>
    </div>
  </section>
</Layout>
