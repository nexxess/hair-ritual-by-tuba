---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import TestimonialCard from "../components/TestimonialCard.astro";
import BeforeAfterCard from "../components/BeforeAfterCard.astro";
import ServiceHighlight from "../components/ServiceHighlight.astro";
import { Icon } from "astro-icon/components";
import salon from "../data/salon.json";

import balayageResult from "../assets/balayage-result.svg";
import stylistWorking from "../assets/stylist-working.svg";
import hairTreatment from "../assets/hair-treatment.svg";
import beforeAfter1a from "../assets/before-after-1a.svg";
import beforeAfter1b from "../assets/before-after-1b.svg";
import beforeAfter2a from "../assets/before-after-2a.svg";
import beforeAfter2b from "../assets/before-after-2b.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const uspIcons: Record<string, string> = {
  consultation:
    "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  products:
    "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
  experience:
    "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z",
  trends: "M13 10V3L4 14h7v7l9-11h-7z",
};
---

<Layout title={`${salon.vollname} – Ihr Friseursalon in Schlangen`}>
  <!-- ========== 1. Hero Section ========== -->
  <section
    class="relative mt-20 min-h-[calc(100vh-5rem)] flex items-center overflow-hidden"
  >
    <video
      class="absolute inset-0 w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src={`${base}/hero.mp4`} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 py-20 lg:py-0 w-full">
      <div class="max-w-2xl">
        <span
          class="section-label !text-gold-light [text-shadow:0_1px_4px_rgba(0,0,0,0.3)] animate-fade-in-up"
          >Willkommen bei {salon.name}</span
        >
        <h1
          class="mt-6 font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] text-white [text-shadow:0_1px_8px_rgba(0,0,0,0.4)] animate-fade-in-up animate-delay-1"
        >
          Das Lächeln im Spiegel<br />
          beginnt mit <span class="italic text-gold-light">uns</span>
        </h1>
        <p
          class="mt-6 text-lg text-white/95 leading-relaxed max-w-lg [text-shadow:0_1px_4px_rgba(0,0,0,0.3)] animate-fade-in-up animate-delay-2"
        >
          Individuelle Beratung, moderne Techniken und Premium-Produkte – für
          Haar, das sich so gut anfühlt, wie es aussieht. Ihr Moment der
          Verwandlung wartet.
        </p>
        <div
          class="mt-10 flex flex-wrap gap-4 animate-fade-in-up animate-delay-3"
        >
          <a href={`${base}/kontakt`} class="btn-primary">Termin vereinbaren</a>
          <a
            href={`${base}/leistungen`}
            class="btn-outline !border-white/60 !text-white hover:!bg-white/10"
            >Unsere Leistungen</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 2. Trust Bar ========== -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 lg:gap-12 text-center">
        {
          salon.vertrauen.map((v) => (
            <div>
              <p class="font-serif text-3xl sm:text-4xl font-semibold text-gold">
                {v.wert}
              </p>
              <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">
                {v.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== 3. Warum Hair Ritual? (USPs) ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="section-label">Warum Hair Ritual?</span>
        <h2
          class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
        >
          Vier Gründe, die<br />
          <span class="italic">den Unterschied machen</span>
        </h2>
        <div class="divider"></div>
      </div>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10"
      >
        {
          salon.usps.map((usp) => (
            <div class="text-center p-6">
              <div class="w-14 h-14 mx-auto mb-6 border border-gold/30 flex items-center justify-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6 text-gold"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d={uspIcons[usp.icon]}
                  />
                </svg>
              </div>
              <h3 class="font-serif text-lg font-semibold text-text-primary mb-3">
                {usp.titel}
              </h3>
              <p class="text-sm text-text-secondary leading-relaxed">
                {usp.text}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== 4. Service Highlights ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 space-y-20 lg:space-y-28">
      <ServiceHighlight
        titel="Balayage & Coloration"
        beschreibung="Natürliche Farbverläufe, die aussehen, als hätte die Sonne sie gemalt. Unsere Balayage-Technik sorgt für sanfte Übergänge und leuchtende Reflexe – individuell abgestimmt auf Ihren Hautton und Typ."
        imageSrc={balayageResult}
        link="/leistungen"
      />
      <ServiceHighlight
        titel="Schnitt & Styling"
        beschreibung="Ob klassischer Bob, moderner Shag oder Curtain Bangs – wir finden den Schnitt, der Ihre Persönlichkeit unterstreicht. Präzise Schnitttechniken für Form, die hält und Volumen, das begeistert."
        imageSrc={stylistWorking}
        reversed={true}
        link="/leistungen"
      />
      <ServiceHighlight
        titel="Pflege & Treatments"
        beschreibung="Kaputte Spitzen, trockenes Haar, Frizz? Unsere intensiven Treatments mit Olaplex und Keratin reparieren die Haarstruktur von innen heraus. Für Haar, das sich wie Seide anfühlt."
        imageSrc={hairTreatment}
        link="/leistungen"
      />
    </div>
  </section>

  <!-- ========== 5. Vorher/Nachher Teaser ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-beige">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="section-label">Ergebnisse, die überzeugen</span>
        <h2
          class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
        >
          Vorher & Nachher
        </h2>
        <div class="divider"></div>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Echte Verwandlungen unserer Kundinnen. Überzeugen Sie sich selbst von
          der Qualität unserer Arbeit.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-12">
        <BeforeAfterCard
          titel={salon.vorherNachher[0].titel}
          beschreibung={salon.vorherNachher[0].beschreibung}
          vorherSrc={beforeAfter1a}
          nachherSrc={beforeAfter1b}
        />
        <BeforeAfterCard
          titel={salon.vorherNachher[1].titel}
          beschreibung={salon.vorherNachher[1].beschreibung}
          vorherSrc={beforeAfter2a}
          nachherSrc={beforeAfter2b}
        />
      </div>
      <div class="text-center mt-12">
        <a href={`${base}/leistungen`} class="btn-outline"
          >Alle Ergebnisse ansehen</a
        >
      </div>
    </div>
  </section>

  <!-- ========== 6. Testimonials ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="section-label">Das sagen unsere Kunden</span>
        <h2
          class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
        >
          Kundenstimmen
        </h2>
        <div class="divider"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          salon.testimonials
            .slice(0, 2)
            .map((t) => (
              <div class="bg-white p-8 lg:p-10 relative border-t-2 border-gold/40">
                <div class="flex gap-1 mb-4">
                  {[...Array(5)].map(() => (
                    <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
                <p class="text-text-secondary leading-relaxed italic">&bdquo;{t.text}&ldquo;</p>
                <div class="mt-6 pt-6 border-t border-beige-dark/30 flex items-center justify-between">
                  <div>
                    <p class="font-serif text-lg font-semibold text-text-primary">{t.name}</p>
                    <p class="text-sm text-gold mt-0.5">{t.leistung}</p>
                  </div>
                  <div class="w-10 h-10 bg-gold/10 border border-gold/20 flex items-center justify-center">
                    <span class="font-serif text-gold font-semibold text-sm">{t.name.charAt(0)}</span>
                  </div>
                </div>
              </div>
            ))
        }
      </div>
    </div>
  </section>

  <!-- ========== 7. Instagram Teaser ========== -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <span class="section-label">Folgen Sie uns auf Instagram</span>
      <h2
        class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
      >
        @{salon.kontakt.instagram}
      </h2>
      <div class="divider"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-lg mx-auto">
        Entdecken Sie unsere neuesten Looks, Vorher/Nachher-Transformationen und
        einen Blick hinter die Kulissen auf Instagram.
      </p>
      <a
        href={salon.kontakt.instagramLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline mt-8 !inline-flex !items-center !gap-2"
      >
        <Icon name="simple-icons:instagram" class="w-4 h-4" />
        Auf Instagram folgen
      </a>
    </div>
  </section>

  <!-- ========== 8. CTA Section ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <span class="section-label">Bereit für Ihre Verwandlung?</span>
      <h2
        class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary"
      >
        Ihr neuer Lieblingslook<br />
        wartet auf Sie
      </h2>
      <div class="divider"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-xl mx-auto">
        Unsere Terminkalender füllen sich schnell – sichern Sie sich noch heute
        Ihren Wunschtermin. Wir freuen uns darauf, Sie zu begeistern.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={`${base}/kontakt`} class="btn-primary">Jetzt Termin buchen</a>
        <a href={salon.kontakt.telefonLink} class="btn-outline">Anrufen</a>
        <a
          href={salon.kontakt.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-whatsapp"
        >
          <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
