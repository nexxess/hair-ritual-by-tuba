---
import { Image } from 'astro:assets';

interface Props {
  titel: string;
  beschreibung: string;
  imageSrc: ImageMetadata;
  reversed?: boolean;
  link: string;
}

const { titel, beschreibung, imageSrc, reversed = false, link } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
  <div class:list={[reversed && "lg:order-2"]}>
    <div class="relative overflow-hidden">
      <Image src={imageSrc} alt={titel} width={600} height={450} class="w-full h-80 lg:h-96 object-cover" />
    </div>
  </div>
  <div class:list={[reversed && "lg:order-1"]}>
    <span class="section-label">Unser Angebot</span>
    <h3 class="mt-3 font-serif text-2xl sm:text-3xl font-semibold text-text-primary">{titel}</h3>
    <div class="divider divider-left"></div>
    <p class="mt-4 text-text-secondary leading-relaxed">{beschreibung}</p>
    <a href={`${base}${link}`} class="btn-outline mt-8 inline-block">Mehr erfahren</a>
  </div>
</div>
