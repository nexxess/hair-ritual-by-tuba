---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { Image } from "astro:assets";
import salon from "../data/salon.json";

import stylistConsultation from "../assets/stylist-consultation.svg";
import salonInterior from "../assets/salon-interior.svg";
import productsShelf from "../assets/products-shelf.svg";
import hairTreatment from "../assets/hair-treatment.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`Über uns – ${salon.vollname}`}>

  <!-- ========== 1. PageHeader ========== -->
  <PageHeader label="Über uns" description="Lernen Sie das Herz hinter Hair Ritual kennen – eine Geschichte von Leidenschaft, Handwerk und dem Wunsch, Menschen zum Strahlen zu bringen.">
    Leidenschaft für<br />
    <span class="italic">perfektes Haar</span>
  </PageHeader>

  <!-- ========== 2. Tugbas Geschichte ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div>
          <span class="section-label">Unsere Geschichte</span>
          <h2 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
            Hinter jedem großartigen Haar<br />
            steht <span class="italic">eine Vision</span>
          </h2>
          <div class="divider divider-left"></div>
          <p class="mt-6 text-text-secondary leading-relaxed text-lg">
            Als Tuğba Dereli vor über zehn Jahren ihre Leidenschaft für Haare zum Beruf machte,
            hatte sie eine klare Vorstellung: Einen Ort schaffen, an dem sich jeder Gast nicht nur
            schöner, sondern auch wohler fühlt. So entstand Hair Ritual in Schlangen.
          </p>
          <p class="mt-6 text-text-secondary leading-relaxed">
            Was als kleiner Traum begann, ist heute ein Salon, dem über 500 Kundinnen und Kunden
            vertrauen. Tuğbas Philosophie ist einfach: Zuhören, verstehen, beraten – und erst dann
            die Schere ansetzen. Denn großartiges Haar entsteht nicht durch Zufall, sondern durch
            echtes Handwerk und echte Kommunikation.
          </p>
          <p class="mt-6 text-text-secondary leading-relaxed">
            Regelmäßige Weiterbildungen, Trend-Schulungen und die Arbeit mit Premium-Produkten
            wie Olaplex und Kérastase sind für Tuğba selbstverständlich. Stillstand gibt es bei
            Hair Ritual nicht – nur die ständige Suche nach dem Besten für Ihr Haar.
          </p>
          <p class="mt-6 text-text-secondary leading-relaxed">
            Ob Balayage, präziser Schnitt oder intensive Pflege – jeder Besuch bei Hair Ritual
            soll ein kleines Ritual sein: Eine Auszeit vom Alltag, nach der Sie mit einem
            Lächeln in den Spiegel schauen.
          </p>
        </div>

        <div class="relative">
          <Image
            src={stylistConsultation}
            alt="Tuğba bei der persönlichen Beratung"
            width={600}
            height={750}
            class="w-full aspect-[4/5] object-cover"
          />
          <div class="absolute -bottom-4 -right-4 w-full h-full border border-gold/20 -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 3. Unsere Werte ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="section-label">Was uns antreibt</span>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
          Unsere Werte
        </h2>
        <div class="divider"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <div class="text-center p-8 bg-white">
          <div class="w-14 h-14 mx-auto mb-6 border border-gold/30 flex items-center justify-center">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">Qualität</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Wir arbeiten ausschließlich mit Premium-Produkten und modernsten Techniken.
            Kompromisse bei der Qualität gibt es bei uns nicht – denn Ihr Haar verdient das Beste.
          </p>
        </div>
        <div class="text-center p-8 bg-white">
          <div class="w-14 h-14 mx-auto mb-6 border border-gold/30 flex items-center justify-center">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">Ehrlichkeit</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Wir beraten Sie ehrlich und transparent. Wenn etwas nicht zu Ihnen passt, sagen wir es Ihnen –
            und finden gemeinsam die Lösung, die wirklich funktioniert.
          </p>
        </div>
        <div class="text-center p-8 bg-white">
          <div class="w-14 h-14 mx-auto mb-6 border border-gold/30 flex items-center justify-center">
            <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <h3 class="font-serif text-xl font-semibold text-text-primary mb-3">Wohlfühl-Atmosphäre</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Unser Salon ist mehr als ein Friseurbesuch – er ist eine Auszeit vom Alltag.
            Bei uns können Sie entspannen, abschalten und sich verwöhnen lassen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 4. Trust Stats ========== -->
  <section class="py-16 lg:py-20 bg-beige">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 lg:gap-12 text-center">
        {salon.vertrauen.map((v) => (
          <div>
            <p class="font-serif text-3xl sm:text-4xl font-semibold text-gold">{v.wert}</p>
            <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">{v.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 5. Kundenstimmen ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="section-label">Kundenstimmen</span>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
          Was unsere Kunden<br />
          <span class="italic">über uns sagen</span>
        </h2>
        <div class="divider"></div>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Echte Bewertungen von echten Kundinnen – darauf sind wir stolz.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {salon.testimonials.map((t) => (
          <div class="bg-cream p-8 lg:p-10 relative border-t-2 border-gold/40">
            <div class="flex gap-1 mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-text-secondary leading-relaxed italic">„{t.text}"</p>
            <div class="mt-6 pt-6 border-t border-beige-dark/30 flex items-center justify-between">
              <div>
                <p class="font-serif text-lg font-semibold text-text-primary">{t.name}</p>
                <p class="text-sm text-gold mt-0.5">{t.leistung}</p>
              </div>
              <div class="w-10 h-10 bg-gold/10 border border-gold/20 flex items-center justify-center">
                <span class="font-serif text-gold font-semibold text-sm">{t.name.charAt(0)}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 6. Salon-Atmosphäre ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="section-label">Unser Salon</span>
        <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
          Ein Ort zum<br />
          <span class="italic">Wohlfühlen</span>
        </h2>
        <div class="divider"></div>
        <p class="mt-4 text-text-secondary leading-relaxed">
          Modernes Ambiente, warme Atmosphäre und eine persönliche Note – willkommen in unserem Salon in Schlangen.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="overflow-hidden">
          <Image src={salonInterior} alt="Salon-Innenraum" width={500} height={400} class="w-full h-64 md:h-80 object-cover hover:scale-105 transition-transform duration-700" />
        </div>
        <div class="overflow-hidden">
          <Image src={productsShelf} alt="Premium-Produkte" width={500} height={400} class="w-full h-64 md:h-80 object-cover hover:scale-105 transition-transform duration-700" />
        </div>
        <div class="overflow-hidden">
          <Image src={hairTreatment} alt="Behandlung im Salon" width={500} height={400} class="w-full h-64 md:h-80 object-cover hover:scale-105 transition-transform duration-700" />
        </div>
      </div>
    </div>
  </section>

  <!-- ========== 7. CTA ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <span class="section-label">Neugierig geworden?</span>
      <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
        Lernen Sie uns<br />
        <span class="italic">persönlich kennen</span>
      </h2>
      <div class="divider"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-xl mx-auto">
        Besuchen Sie uns im Salon oder vereinbaren Sie einen Termin für eine kostenlose Beratung.
        Wir nehmen uns Zeit für Sie – versprochen.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={`${base}/kontakt`} class="btn-primary">Kontakt aufnehmen</a>
        <a href={`${base}/leistungen`} class="btn-outline">Leistungen ansehen</a>
      </div>
    </div>
  </section>

</Layout>
