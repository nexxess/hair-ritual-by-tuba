---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import salon from "../data/salon.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`Über uns – ${salon.vollname}`}>

  <PageHeader label="Über uns">
    Leidenschaft für<br />
    <span class="italic">perfektes Haar</span>
  </PageHeader>

  <!-- ========== Über uns Inhalt ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        <div>
          <p class="text-text-secondary leading-relaxed text-lg">
            Bei {salon.vollname} verbinden wir jahrelange Erfahrung mit den
            neuesten Trends und Techniken. Jeder Besuch beginnt mit einer
            persönlichen Beratung, denn wir glauben: Großartiges Haar entsteht
            durch Zuhören, Verstehen und handwerkliches Können.
          </p>
          <p class="mt-6 text-text-secondary leading-relaxed">
            Wir arbeiten ausschließlich mit hochwertigen Pflegeprodukten und
            legen besonderen Wert auf schonende Behandlungen, die Ihr Haar
            langfristig gesund und strahlend halten.
          </p>
          <p class="mt-6 text-text-secondary leading-relaxed">
            Unser Salon in {salon.adresse.ort} ist ein Ort, an dem Sie sich
            wohlfühlen und entspannen können. Wir nehmen uns Zeit für Sie –
            denn Ihr Haar verdient die beste Pflege.
          </p>
        </div>

        <!-- Platzhalter für Bild -->
        <div class="relative">
          <div class="aspect-[4/5] bg-cream flex items-center justify-center">
            <div class="text-center p-8">
              <div class="w-20 h-20 mx-auto mb-6 border border-gold/30 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gold/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <p class="text-text-muted text-sm">Hier kommt Ihr Bild hin</p>
            </div>
          </div>
          <div class="absolute -bottom-4 -right-4 w-full h-full border border-gold/20 -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Vertrauens-Elemente ========== -->
  <section class="py-16 lg:py-20 bg-beige">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 text-center">
        {salon.vertrauen.map((v) => (
          <div>
            <p class="font-serif text-4xl font-semibold text-gold">{v.wert}</p>
            <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">{v.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-white">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <span class="section-label">Neugierig geworden?</span>
      <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
        Lernen Sie uns persönlich kennen
      </h2>
      <div class="divider"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-xl mx-auto">
        Besuchen Sie uns im Salon oder vereinbaren Sie einen Termin – wir freuen uns auf Sie.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={`${base}/kontakt`} class="btn-primary">Kontakt aufnehmen</a>
        <a href={`${base}/leistungen`} class="btn-outline">Leistungen ansehen</a>
      </div>
    </div>
  </section>

</Layout>
