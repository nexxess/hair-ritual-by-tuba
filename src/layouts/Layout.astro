---
import '../styles/global.css'

import '@fontsource/inter/300.css'
import '@fontsource/inter/400.css'
import '@fontsource/inter/500.css'
import '@fontsource/inter/600.css'
import '@fontsource/playfair-display/400.css'
import '@fontsource/playfair-display/400-italic.css'
import '@fontsource/playfair-display/500.css'
import '@fontsource/playfair-display/500-italic.css'
import '@fontsource/playfair-display/600.css'
import '@fontsource/playfair-display/700.css'

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Hair Ritual by Tuba – Ihr Friseursalon für moderne Schnitttechniken und hochwertige Pflegeprodukte.' } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/#leistungen', label: 'Leistungen' },
	{ href: '/#ueber-uns', label: 'Über uns' },
	{ href: '/kontakt', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>

	</head>
	<body class="min-h-screen bg-white antialiased">
		<!-- ========== Navigation ========== -->
		<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent">
			<nav class="mx-auto max-w-7xl px-6 lg:px-8">
				<div class="flex items-center justify-between h-20">
					<!-- Logo -->
					<a href="/" class="flex flex-col leading-tight">
						<span class="font-serif text-xl font-semibold tracking-wide text-text-primary">Hair Ritual</span>
						<span class="text-[0.65rem] font-sans font-medium tracking-[0.25em] uppercase text-gold">by Tuba</span>
					</a>

					<!-- Desktop Navigation -->
					<div class="hidden md:flex items-center gap-8">
						{navLinks.map((link) => (
							<a
								href={link.href}
								class:list={[
									'text-[0.8125rem] font-medium tracking-[0.08em] uppercase transition-colors duration-300 hover:text-gold',
									currentPath === link.href ? 'text-gold' : 'text-text-secondary'
								]}
							>
								{link.label}
							</a>
						))}
					</div>

					<!-- Mobile Menu Button -->
					<button
						id="mobile-menu-btn"
						class="md:hidden flex flex-col gap-1.5 p-2"
						aria-label="Menü öffnen"
					>
						<span class="block w-6 h-px bg-text-primary transition-all duration-300" id="bar1"></span>
						<span class="block w-6 h-px bg-text-primary transition-all duration-300" id="bar2"></span>
						<span class="block w-4 h-px bg-text-primary transition-all duration-300 ml-auto" id="bar3"></span>
					</button>
				</div>
			</nav>

			<!-- Mobile Menu -->
			<div id="mobile-menu" class="hidden md:hidden bg-white/98 backdrop-blur-md border-t border-beige">
				<div class="px-6 py-8 flex flex-col gap-6">
					{navLinks.map((link) => (
						<a
							href={link.href}
							class:list={[
								'text-sm font-medium tracking-[0.08em] uppercase transition-colors duration-300',
								currentPath === link.href ? 'text-gold' : 'text-text-secondary'
							]}
						>
							{link.label}
						</a>
					))}
				</div>
			</div>
		</header>

		<!-- ========== Hauptinhalt ========== -->
		<main>
			<slot />
		</main>

		<!-- ========== Footer ========== -->
		<footer class="bg-text-primary text-beige">
			<div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 lg:py-20">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
					<!-- Spalte 1: Marke -->
					<div>
						<a href="/" class="inline-block mb-6">
							<span class="font-serif text-2xl font-semibold text-white">Hair Ritual</span>
							<span class="block text-[0.65rem] font-medium tracking-[0.25em] uppercase text-gold-light mt-0.5">by Tuba</span>
						</a>
						<p class="text-sand text-sm leading-relaxed max-w-xs">
							Moderne Schnitttechniken und hochwertige Pflegeprodukte für Ihr individuelles Haarstyling.
						</p>
					</div>

					<!-- Spalte 2: Öffnungszeiten -->
					<div>
						<h3 class="text-white text-sm font-sans font-medium tracking-[0.15em] uppercase mb-6">Öffnungszeiten</h3>
						<div class="space-y-2 text-sm text-sand">
							<div class="flex justify-between">
								<span>Montag</span>
								<span>Geschlossen</span>
							</div>
							<div class="flex justify-between">
								<span>Dienstag – Freitag</span>
								<span>09:00 – 18:00</span>
							</div>
							<div class="flex justify-between">
								<span>Samstag</span>
								<span>09:00 – 15:00</span>
							</div>
						</div>
					</div>

					<!-- Spalte 3: Kontakt -->
					<div>
						<h3 class="text-white text-sm font-sans font-medium tracking-[0.15em] uppercase mb-6">Kontakt</h3>
						<div class="space-y-3 text-sm text-sand">
							<p>Musterstraße 12<br />12345 Musterstadt</p>
							<p>
								<a href="tel:+4912345678" class="hover:text-gold-light transition-colors">+49 123 456 78</a>
							</p>
							<p>
								<a href="mailto:info@hair-ritual.de" class="hover:text-gold-light transition-colors">info@hair-ritual.de</a>
							</p>
						</div>
					</div>
				</div>

				<!-- Copyright -->
				<div class="mt-16 pt-8 border-t border-white/10 text-center">
					<p class="text-xs text-sand-dark tracking-wide">
						&copy; {new Date().getFullYear()} Hair Ritual by Tuba. Alle Rechte vorbehalten.
					</p>
				</div>
			</div>
		</footer>

		<!-- ========== Scripts ========== -->
		<script>
			// Mobile Menü Toggle
			const menuBtn = document.getElementById('mobile-menu-btn');
			const mobileMenu = document.getElementById('mobile-menu');
			const bar1 = document.getElementById('bar1');
			const bar2 = document.getElementById('bar2');
			const bar3 = document.getElementById('bar3');
			let isMenuOpen = false;

			menuBtn?.addEventListener('click', () => {
				isMenuOpen = !isMenuOpen;
				mobileMenu?.classList.toggle('hidden');

				if (isMenuOpen) {
					bar1!.style.transform = 'rotate(45deg) translate(4px, 4px)';
					bar2!.style.opacity = '0';
					bar3!.style.transform = 'rotate(-45deg) translate(3px, -3px)';
					bar3!.style.width = '1.5rem';
				} else {
					bar1!.style.transform = '';
					bar2!.style.opacity = '1';
					bar3!.style.transform = '';
					bar3!.style.width = '1rem';
				}
			});

			// Header-Hintergrund beim Scrollen
			const header = document.getElementById('site-header');
			window.addEventListener('scroll', () => {
				if (window.scrollY > 50) {
					header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
					header?.classList.remove('bg-transparent');
				} else {
					header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
					header?.classList.add('bg-transparent');
				}
			});
		</script>
	</body>
</html>
