---
import Layout from "../layouts/Layout.astro";
import salon from "../data/salon.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${salon.vollname} – Friseursalon für moderne Schnitttechniken`}>

  <!-- ========== Hero Section ========== -->
  <section class="relative min-h-screen flex items-center bg-cream">
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-0 right-0 w-1/2 h-full bg-beige/50 hidden lg:block"></div>
      <div class="absolute bottom-0 left-1/4 w-px h-1/3 bg-gold/20"></div>
      <div class="absolute top-1/4 right-1/3 w-px h-1/4 bg-gold/10"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6 lg:px-8 py-32 lg:py-0 w-full">
      <div class="max-w-2xl">
        <span class="section-label animate-fade-in-up">Willkommen bei {salon.name}</span>
        <h1 class="mt-6 font-serif text-4xl sm:text-5xl lg:text-6xl font-semibold leading-[1.1] text-text-primary animate-fade-in-up animate-delay-1">
          Ihr Haar verdient<br />
          <span class="italic text-gold">besondere</span> Pflege
        </h1>
        <p class="mt-6 text-lg text-text-secondary leading-relaxed max-w-lg animate-fade-in-up animate-delay-2">
          Moderne Schnitttechniken, hochwertige Pflegeprodukte und individuelle
          Beratung – für ein Ergebnis, das Sie begeistert.
        </p>
        <div class="mt-10 flex flex-wrap gap-4 animate-fade-in-up animate-delay-3">
          <a href={`${base}/kontakt`} class="btn-primary">Termin vereinbaren</a>
          <a href={`${base}/leistungen`} class="btn-outline">Unsere Leistungen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Vertrauens-Elemente ========== -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 text-center">
        {salon.vertrauen.map((v) => (
          <div>
            <p class="font-serif text-4xl font-semibold text-gold">{v.wert}</p>
            <p class="mt-2 text-sm text-text-secondary tracking-wide uppercase">{v.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CTA Section ========== -->
  <section class="py-(--spacing-section) lg:py-(--spacing-section-lg) bg-cream">
    <div class="mx-auto max-w-3xl px-6 lg:px-8 text-center">
      <span class="section-label">Bereit für Ihr neues Ich?</span>
      <h2 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold text-text-primary">
        Vereinbaren Sie Ihren Termin
      </h2>
      <div class="divider"></div>
      <p class="mt-4 text-text-secondary leading-relaxed max-w-xl mx-auto">
        Wir freuen uns darauf, Sie in unserem Salon willkommen zu heißen.
        Kontaktieren Sie uns für eine persönliche Beratung oder einen Termin.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={`${base}/kontakt`} class="btn-primary">Jetzt Termin buchen</a>
        <a href={salon.kontakt.telefonLink} class="btn-outline">Anrufen</a>
      </div>
    </div>
  </section>

</Layout>
